# APK 文件以 .zip 后缀存储以绕过 InfinityFree 的文件类型拦截
# 实际下载通过 download.php 完成，设置正确的文件名和响应头

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^download/.*\.zip$ /apps/floating-clock/download.php [L,R=302]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "download\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>
