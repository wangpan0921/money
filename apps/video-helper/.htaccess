# APK 文件以 .zip 后缀存储以绕过 InfinityFree 的文件类型拦截
# 实际下载通过 download.php 完成,设置正确的 Content-Type 和文件名

# 防止直接访问 .zip 文件(引导走 download.php)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^download/.*\.zip$ /apps/video-helper/download.php [L,R=302]
</IfModule>

# 确保 PHP 脚本不被缓存
<IfModule mod_headers.c>
    <FilesMatch "download\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>
